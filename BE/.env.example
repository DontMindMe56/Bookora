NODE_ENV=development
PORT=3000
APP_URL=http://localhost:5173          # URL frontend, dùng trong link email
CORS_ORIGIN=http://localhost:5173
TRUST_PROXY=0

DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=root
DB_PASSWORD=root
DB_NAME=bookstore
# DB_SOCKET=/var/run/mysqld/mysqld.sock   # dùng thay cho host/port nếu cần

JWT_SECRET=doi-chuoi-bi-mat-nay-o-production

# GHN (bỏ trống token => không đồng bộ được danh mục địa giới)
GHN_TOKEN=
GHN_BASE_URL=https://online-gateway.ghn.vn/shiip/public-api
GHN_TIMEOUT_MS=10000
GHN_SHOP_ID=                 # bắt buộc để tính phí / tạo vận đơn
# GHN_FROM_DISTRICT_ID=      # tùy chọn
GHN_SERVICE_TYPE_ID=2

GHN_WEBHOOK_TOKEN=           # bắt buộc để nhận webhook GHN (/api/webhooks/ghn?token=...)
# GHN_AUTO_CREATE=1          # 0 = không tự tạo vận đơn sau khi đơn xác nhận

# SePay
SEPAY_API_KEY=               # SePay gửi webhook với header "Authorization: Apikey <key>"
SEPAY_WEBHOOK_SECRET=        # khuyến nghị: bật HMAC-SHA256 ở SePay, điền Secret Key (có giá trị thì bỏ qua kiểm tra API key)
SEPAY_BANK=MBBank
SEPAY_ACCOUNT_NO=
SEPAY_ACCOUNT_NAME=

UPLOAD_DIR=uploads
# DOCS_ENABLED=1             # bật /api/docs ở production

# SMTP (bỏ trống => email chỉ in ra console khi dev)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Nhà sách <no-reply@example.com>"

# Dùng cho: npm run create-admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Admin@12345
ADMIN_NAME=Quản trị viên

# VNPay (sandbox: đăng ký tại sandbox.vnpayment.vn để nhận TMN_CODE / SECRET)
VNPAY_TMN_CODE=
VNPAY_SECRET=
VNPAY_HOST=https://sandbox.vnpayment.vn
# (frontend thật: VNPAY_RETURN_URL=http://localhost:5173/payment/vnpay-return — trang frontend gọi GET /api/webhooks/vnpay/return?<query VNPay>)
# Thử bằng trang demo của backend: VNPAY_RETURN_URL=http://localhost:5173/payment/vnpay-return
# IPN URL khai báo trên cổng VNPay: https://<domain>/api/webhooks/vnpay/ipn

# Google đăng nhập (Client ID của OAuth 2.0 Web client; frontend gửi ID token tới POST /api/auth/google)
GOOGLE_CLIENT_ID=

# Facebook đăng nhập (developers.facebook.com → app loại Consumer, bật "Facebook Login"; frontend gửi access token tới POST /api/auth/facebook)
# App ở chế độ Development chỉ cho tài khoản có vai trò (admin/developer/tester) đăng nhập.
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

VNPAY_RETURN_URL=http://localhost:5173/payment/vnpay-return

# URL công khai (ngrok...) để dán vào cổng thanh toán; dùng: node scripts/use-ngrok.js https://<tên-miền>
# PUBLIC_URL=
