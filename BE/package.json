{
  "name": "bookstore-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "create-admin": "node scripts/create-admin.js",
    "snapshot": "node scripts/api-snapshot.js",
    "db:init": "node scripts/db-init.js",
    "test:fresh": "npm run db:init -- --test && npm test",
    "test": "node --test --test-concurrency=1 \"test/**/*.test.js\"",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write . ../FE",
    "format:check": "prettier --check . ../FE",
    "check": "npm run lint && npm run format:check",
    "seed-demo": "node scripts/seed-demo.js",
    "migrate:facebook": "node scripts/add-facebook-column.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^4.22.3",
    "express-rate-limit": "^8.7.1",
    "google-auth-library": "^11.3.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.5.0",
    "mysql2": "^3.24.6",
    "nodemailer": "^10.2.1",
    "sharp": "^0.35.5",
    "swagger-ui-express": "^5.0.1",
    "vnpay": "^2.5.0",
    "xss": "^1.0.17",
    "zod": "^3.25.76",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.10"
  }
}
